{
  "name": "terasdocs",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Lightweight, self-hosted documentation platform powered by Markdown and JSON",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "dev:css": "npx @tailwindcss/cli -i ./public/css/input.css -o ./public/assets/app.css --watch",
    "build": "npm run build:css",
    "build:css": "npx @tailwindcss/cli -i ./public/css/input.css -o ./public/assets/app.css --minify",
    "start": "node --env-file-if-exists=.env src/server.js",
    "hash-password": "node scripts/hash-password.js",
    "test": "node --test"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "express": "^5.2.0",
    "marked": "^16.4.1",
    "sanitize-html": "^2.17.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.14",
    "tailwindcss": "^4.1.14"
  }
}
